process {

    resourceLimits = [
        cpus: params.max_cpus,
        memory: params.max_memory,
        time: params.max_time
    ]

    // The defaults for all processes
    cpus   = { 16    * task.attempt }
    memory = { 10.GB * task.attempt }
    time   = { 10.h  * task.attempt }

    errorStrategy = { task.exitStatus in [140,143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_low {
        cpus   = { 4 }
        memory = { 10.GB * task.attempt }
        time   = { 4.h }
    }

    withLabel:process_medium {
        cpus   = { 24 }
        memory = { 50.GB * task.attempt }
        time   = { 24.h }
    }

    withLabel:process_high {
        cpus   = { 48 }
        memory = { 250.GB * task.attempt }
        time   = { 72.h }
    }

    // this label is not used by any modules, but serves as an example of how to use the largemem queue if needed
    withLabel:process_largemem {
        cpus   = { 48 }
        memory = { 500.GB * task.attempt }
        time   = { 72.h }
        queue = 'largemem'
        clusterOptions = ' --gres=lscratch:750 '
     }
}
